# ============================================
# Email Configuration
# ============================================

# Email Provider Selection
# Options: resend | emailjs
# Default: resend
EMAIL_PROVIDER=resend

# Resend Configuration (API-based email service)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM="ITI_Ecommerce <example@gmail.com>"

# EmailJS Configuration (Template-based email service)
# Get your credentials from: https://dashboard.emailjs.com/
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx
EMAILJS_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxx

# SMTP Configuration (for Nodemailer - if needed in future)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="example@gmail.com"
SMTP_PASS="your_email_password"
MAIL_FROM="ITI_Ecommerce <example@gmail.com>"
SMTP_FROM="ITI_Ecommerce <example@gmail.com>"
RESEND_API_KEY=api_key_for_resend_service
